<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live chat</title>
    <link rel="stylesheet" href="css/chat.css">
</head>

<body>
    <div class="chat-page">
        <div id="chatHistory" class="chat-history">
        </div>
        <div class="chat-form">
            <form action="" id="sendMessageForm">
                <input type="text" id="messageBox" autocomplete="off" autofocus/>
                <button>Send</button>
            </form>
        </div>
    </div>
    <script>
        const nickname = '<%= nickname %>';
        let lastMessageId = '<%= userJoinMessageId-1 %>'
        let autoScroll = true;
        function sendMessage() {
            const messageContent = document.getElementById('messageBox').value;
            if (messageContent.trim() === '') {
                return;
            }

            fetch('/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ messageContent, nickname })
            });

            document.getElementById('messageBox').value = '';
        }
        let pollinterval = 100;
        async function poll() {
            try {
                const response = await fetch('/poll?lastMessageId=' + lastMessageId);
                const data = await response.json();


                const chatHistoryElem = document.getElementById('chatHistory');
                if (data.history.length > 0) {
                    chatHistoryElem.innerHTML += data.history
                        .map(his => `<p class="${getClassNameByNickname(his.nickname)}"><span class="message-datetime" data-ts="${his.datetime}">${displayedDateTime(new Date(his.datetime))}</span><br>${his.nickname}: ${his.
                            message}</p>`).join('');
                    lastMessageId = data.history[data.history.length - 1].id;
                }
                if (autoScroll) {
                    chatHistoryElem.scrollTop = chatHistoryElem.scrollHeight;
                }
                pollinterval = 100;
            } catch (error) {
                console.error(error);
                pollinterval = Math.min(pollinterval * 2, 30000);
            }



            setTimeout(poll, 100);
        }

        function getClassNameByNickname(theNickname) {
            if (theNickname === 'System') {
                return 'system-msg'
            }
            if (theNickname === nickname) {
                return 'myself-msg'
            }
            return '';
        }

        document.addEventListener('DOMContentLoaded', () => {
            poll();
            document.getElementById('sendMessageForm').addEventListener('submit', e => {
                e.preventDefault();
                sendMessage();
            })

            document.getElementById('chatHistory').addEventListener('scroll', () => {
                const chatHisElem = document.getElementById('chatHistory');
                const bottomSpace = chatHisElem.scrollHeight - chatHisElem.scrollTop - chatHisElem.clientHeight;
                autoScroll = bottomSpace < 5;
            });
            updateDisplayedTime();
        });
            function updateDisplayedTime() {
                
                const dateTimeSpans = document.getElementById('chatHistory').querySelectorAll('span.message-datetime');
                dateTimeSpans.forEach(dateTimeSpan => {
                    dateTimeSpan.dataset.get
                    const timestamp = dateTimeSpan.dataset['ts'];
                    const dateTimestring = displayedDateTime(new Date(timestamp));
                    dateTimeSpan.innerHTML = dateTimestring;
                })
 

                setTimeout(updateDisplayedTime, 30000);
            }


            const month = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

        function displayedDateTime(dateTime) {
            const nowDate = new Date()
            const now = Date.now()
            if (now - dateTime.getTime() < 60 * 1000) {
                return 'now';
            }
            if (now - dateTime.getTime() < 60 * 60 * 1000) {
                return `${Math.round((now - dateTime.getTime()) / 1000 / 60)} minutes ago`
            }
            if (nowDate.getFullYear() === dateTime.getFullYear()
                && nowDate.getMonth() === dateTime.getMonth()
                && nowDate.getDate() === dateTime.getDate()) {
                return `${dateTime.getHours()}:${dateTime.getMinutes()}`;
            }
            return `${dateTime.getDate()} ${months[dateTime.getMonth()]} ${dateTime.getHours()}:${dateTime.getMinutes()}`;
        }


    </script>
</body>

</html>